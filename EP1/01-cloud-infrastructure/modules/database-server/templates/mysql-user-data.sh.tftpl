#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/user-data-mysql.log | logger -t user-data -s 2>/dev/console) 2>&1

# FreshBox EP1 — capa Data (Learner Lab)
# MariaDB desde repos Amazon Linux (evita timeout de Docker Hub en el lab).

dnf update -y
dnf install -y mariadb105-server

mkdir -p /etc/my.cnf.d
cat > /etc/my.cnf.d/freshbox-bind.cnf <<'CNF'
[mysqld]
bind-address=0.0.0.0
skip-networking=0
port=3306
CNF

systemctl enable --now mariadb

for i in $(seq 1 60); do
  if mysqladmin ping --silent 2>/dev/null; then
    break
  fi
  sleep 2
done

mysql -e "CREATE DATABASE IF NOT EXISTS \`${db_name}\`;"

# Usuario de aplicacion (compatible MariaDB 10.5)
mysql -e "DROP USER IF EXISTS '${db_user}'@'%';" || true
mysql -e "CREATE USER '${db_user}'@'%' IDENTIFIED BY '${db_password}';"
mysql -e "GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO '${db_user}'@'%';"
mysql -e "FLUSH PRIVILEGES;"

mkdir -p /opt/freshbox
cat > /opt/freshbox/init.sql <<'SQL'
${init_sql}
SQL

mysql "${db_name}" < /opt/freshbox/init.sql

mysql -u"${db_user}" -p"${db_password}" -h127.0.0.1 "${db_name}" \
  -e "SELECT COUNT(*) AS productos FROM productos;"

# Señal de listo para las instancias App
touch /opt/freshbox/mysql-ready
echo "=== FreshBox MariaDB user-data completado ==="
